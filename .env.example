# Backend API base URL (Cloudflare Worker). Falls back to the production
# worker if unset, but every environment should define its own.
 
# Public site origin, used for canonical URLs, Open Graph tags and the
# generated sitemap. Must NOT have a trailing slash.
VITE_SITE_URL=https://kekalstudio.com

# Cloudinary (image hosting/uploads — admin only)
VITE_CLOUDINARY_CLOUD_NAME=dkewwryqv
VITE_CLOUDINARY_UPLOAD_PRESET=kekal_library
VITE_CLOUDINARY_FOLDER=kekal
